# Web image (Next.js 15). Node runs next build/start; Bun is the installer
# (ADR-0006). Lab-grade; standalone-output optimization is Phase 9.
FROM node:20-alpine AS base
WORKDIR /app

RUN npm install -g bun@1.2

COPY package.json bun.lock* turbo.json ./
COPY packages/config/package.json packages/config/
COPY apps/web/package.json apps/web/

RUN bun install --ignore-scripts

COPY packages ./packages
COPY apps/web ./apps/web

ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run --filter @wirewatch/web build

EXPOSE 3100
CMD ["bun", "run", "--filter", "@wirewatch/web", "start"]
