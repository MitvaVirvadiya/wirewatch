{
  "name": "wirewatch",
  "private": true,
  "version": "0.0.0",
  "description": "Finance-aware reliability monitoring for provider integrations. R&D lab — synthetic data only.",
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "engines": { "bun": ">=1.2" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "bun run --filter @wirewatch/db generate",
    "db:migrate": "bun run --filter @wirewatch/db migrate",
    "db:seed": "bun run --filter @wirewatch/db seed",
    "db:studio": "bun run --filter @wirewatch/db studio",
    "smoke": "bun scripts/smoke.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
