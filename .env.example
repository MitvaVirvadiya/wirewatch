# ── Environment gate ──────────────────────────────────────────────────
# local | test | staging | production — gates debug/seed/simulator endpoints
APP_ENV="local"

# ── Database ──────────────────────────────────────────────────────────
# Local default matches docker-compose.yml credentials — works as-is.
# For staging/prod, replace with the Neon connection string.
DATABASE_URL="postgres://wirewatch:wirewatch@localhost:5432/wirewatch"

# ── Redis ─────────────────────────────────────────────────────────────
# Local default matches docker-compose.yml. REDIS_URL is used by api/worker.
# Upstash REST vars are needed only when using Upstash (staging/prod).
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Auth (better-auth, ADR-0005) ──────────────────────────────────────
BETTER_AUTH_SECRET="generate-me-32-bytes"
BETTER_AUTH_URL="http://localhost:3100"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=""
LOG_LEVEL="info"

# ── Ingestion security ────────────────────────────────────────────────
INGEST_HMAC_SECRET="generate-me"      # per-monitor secrets override this
SEED_SECRET="change-me"               # guards seed endpoints (local only)

# ── Stripe (TEST MODE ONLY — never live keys) ─────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_TEAM="price_..."

# ── Web → API ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
